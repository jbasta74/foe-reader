{
  "manifest_version": 3,
  "name": "FoE Reader",
  "version": "0.3.41",
  "description": "Pasivně čte komunikaci Forge of Empires (json?h + WebSocket) a zobrazuje přehled. Nic neodesílá.",
  "content_scripts": [
    {
      "matches": [
        "https://*.forgeofempires.com/game/*"
      ],
      "js": [
        "inject.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://*.forgeofempires.com/game/*"
      ],
      "js": [
        "provinces.js",
        "nego-solver-helper.js",
        "nego.js",
        "stats.js",
        "panel.js"
      ],
      "run_at": "document_start"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "img/incidents/*.png"
      ],
      "matches": [
        "https://*.forgeofempires.com/*"
      ]
    }
  ],
  "permissions": [
    "storage"
  ]
}
